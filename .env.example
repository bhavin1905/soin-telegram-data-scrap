# Telegram API Configuration
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION=your_session_name

# Webhook Configuration
WEBHOOK_URL=https://your-webhook-url.com/endpoint

# MongoDB Configuration
MONGODB_URI=mongodb://your_mongodb_uri

# Error Notification Configuration (NEW)
# Bot token for sending error notifications (create a bot via @BotFather)
ERROR_NOTIFICATION_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Chat ID where error notifications will be sent (can be your personal chat ID or a group)
ERROR_NOTIFICATION_CHAT_ID=-1001234567890
